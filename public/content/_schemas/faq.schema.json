{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Page FAQ",
  "description": "Titres et questions editables (les reponses restent en HTML dur).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eyebrow":    { "type": "string", "maxLength": 120 },
        "title":      { "type": "string", "maxLength": 80 },
        "script_sub": { "type": "string", "maxLength": 120 }
      }
    },
    "reservation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title":         { "type": "string", "maxLength": 40 },
        "q_prendre_rdv": { "type": "string", "maxLength": 200 },
        "q_depot":       { "type": "string", "maxLength": 200 },
        "q_retard":      { "type": "string", "maxLength": 200 },
        "q_paiement":    { "type": "string", "maxLength": 200 }
      }
    },
    "onglerie": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title":          { "type": "string", "maxLength": 40 },
        "q_duree_pose":   { "type": "string", "maxLength": 200 },
        "q_duree_seance": { "type": "string", "maxLength": 200 },
        "q_inspiration":  { "type": "string", "maxLength": 200 }
      }
    },
    "epilation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title":       { "type": "string", "maxLength": 40 },
        "q_douleur":   { "type": "string", "maxLength": 200 },
        "q_longueur":  { "type": "string", "maxLength": 200 },
        "q_frequence": { "type": "string", "maxLength": 200 }
      }
    },
    "studio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title":           { "type": "string", "maxLength": 40 },
        "q_adresse":       { "type": "string", "maxLength": 200 },
        "q_accompagnants": { "type": "string", "maxLength": 200 }
      }
    },
    "cta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text":   { "type": "string", "maxLength": 120 },
        "button": { "type": "string", "maxLength": 60 }
      }
    }
  }
}
