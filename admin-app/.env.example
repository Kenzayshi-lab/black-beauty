# =========================================================
# Black & Beauty Studio — Console admin — Variables d'environnement
# ---------------------------------------------------------
# Copier ce fichier vers .env.local pour le developpement local.
# En production Vercel, definir chaque variable dans le dashboard
# du projet (Settings > Environment Variables).
# NE PAS commiter .env.local (voir .gitignore).
# =========================================================

# --- Auth.js -------------------------------------------------------
# Secret aleatoire de 32 octets minimum. Genere avec:
#   openssl rand -base64 32
AUTH_SECRET=

# URL publique de l'admin (utilise par Auth.js pour les callbacks)
# En dev: http://localhost:3000
# En prod: https://admin.blackandbeautystudio.ca
AUTH_URL=

# Duree de session (secondes). Defaut: 900 = 15 min.
SESSION_TTL=900

# --- Vercel KV ----------------------------------------------------
# Fournis automatiquement par Vercel quand la KV est provisionnee
# sur le projet (Storage > KV > Connect).
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# --- GitHub API ---------------------------------------------------
# Personal Access Token fine-grained avec scope contents:write
# UNIQUEMENT sur le repo Kenzayshi-lab/black-beauty.
# Rotation tous les 90 jours (voir docs/rotation-secrets.md).
GITHUB_PAT=
GITHUB_OWNER=Kenzayshi-lab
GITHUB_REPO=black-beauty
GITHUB_DEFAULT_BRANCH=main

# --- Divers -------------------------------------------------------
# Salt supplementaire pour hasher les IPs dans les logs (Loi 25).
IP_HASH_SALT=
