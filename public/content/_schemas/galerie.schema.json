{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Page Galerie",
  "description": "Textes de la page galerie + liste des photos.",
  "type": "object",
  "additionalProperties": false,
  "required": ["photos"],
  "properties": {
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eyebrow":    { "type": "string", "maxLength": 120 },
        "title":      { "type": "string", "maxLength": 80 },
        "script_sub": { "type": "string", "maxLength": 120 }
      }
    },
    "intro": { "type": "string", "maxLength": 500 },
    "instagram_button_text": { "type": "string", "maxLength": 60 },
    "cta_final": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eyebrow":     { "type": "string", "maxLength": 120 },
        "title":       { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 400 },
        "button_text": { "type": "string", "maxLength": 60 }
      }
    },
    "photos": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["src", "alt"],
        "properties": {
          "src":  { "type": "string", "pattern": "^(/assets/|https://)[A-Za-z0-9._/-]+$", "maxLength": 500 },
          "alt":  { "type": "string", "maxLength": 200 },
          "link": { "type": "string", "pattern": "^https://", "maxLength": 500 }
        }
      }
    }
  }
}
