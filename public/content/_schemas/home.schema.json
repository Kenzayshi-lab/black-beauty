{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Page d'accueil",
  "description": "Textes editables de l'accueil (hero, sections, CTA final).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eyebrow":             { "type": "string", "maxLength": 120 },
        "title":               { "type": "string", "maxLength": 120 },
        "tagline":             { "type": "string", "maxLength": 200 },
        "subtitle":            { "type": "string", "maxLength": 200 },
        "cta_secondary_text":  { "type": "string", "maxLength": 80 }
      }
    },
    "services_section": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eyebrow": { "type": "string", "maxLength": 80 },
        "title":   { "type": "string", "maxLength": 120 }
      }
    },
    "prices_section": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eyebrow": { "type": "string", "maxLength": 80 },
        "title":   { "type": "string", "maxLength": 120 }
      }
    },
    "about_teaser": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eyebrow": { "type": "string", "maxLength": 80 },
        "title":   { "type": "string", "maxLength": 200 }
      }
    },
    "instagram_section": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title":    { "type": "string", "maxLength": 120 },
        "subtitle": { "type": "string", "maxLength": 200 }
      }
    },
    "policies_section": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eyebrow": { "type": "string", "maxLength": 80 },
        "title":   { "type": "string", "maxLength": 120 }
      }
    },
    "cta_final": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eyebrow":     { "type": "string", "maxLength": 120 },
        "title":       { "type": "string", "maxLength": 120 },
        "script":      { "type": "string", "maxLength": 120 },
        "button_text": { "type": "string", "maxLength": 80 }
      }
    }
  }
}
