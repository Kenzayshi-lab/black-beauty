# =========================================================
# Black & Beauty Studio — Console admin — Variables d'env
# ---------------------------------------------------------
# Copier vers .env.local en dev. En prod : dashboard Vercel
# (projet bbstudio-admin > Settings > Environment Variables).
# NE PAS commiter .env.local.
#
# ⚠️ Depuis le passage a Firebase Auth, l'app ne depend plus
# d'Auth.js ni d'une base Redis obligatoire. La config Firebase
# (publique) est dans lib/firebase-client.ts, pas ici.
# =========================================================

# --- GitHub API (REQUIS pour ecrire les modifs du site) -----------
# PAT fine-grained, scope contents:write sur Kenzayshi-lab/black-beauty.
GITHUB_PAT=
GITHUB_OWNER=Kenzayshi-lab
GITHUB_REPO=black-beauty
GITHUB_DEFAULT_BRANCH=main

# --- Optionnel : journal d'audit + rate limiting ------------------
# Si REDIS_URL est absent, ces fonctionnalites sont simplement
# desactivees (l'app marche quand meme). Firebase assure deja sa
# propre protection anti-brute-force sur le login.
REDIS_URL=
IP_HASH_SALT=
