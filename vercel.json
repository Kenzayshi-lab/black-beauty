{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/onglerie",    "destination": "/onglerie.html" },
    { "source": "/epilation",   "destination": "/epilation.html" },
    { "source": "/galerie",     "destination": "/galerie.html" },
    { "source": "/reservation", "destination": "/reservation.html" },
    { "source": "/apropos",     "destination": "/apropos.html" },
    { "source": "/faq",         "destination": "/faq.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
